# --- данные организаторов ---
# Датасет в репозиторий не кладётся: он выдаётся организаторами и весит гигабайты.
Данные/
data/

# --- тяжёлые промежуточные артефакты обучения ---
# Кеши эмбеддингов и чекпойнты. Исключение — кеш двойника релиза: на нём считаются
# все диагностики, и без него их нельзя воспроизвести, а весит он 13 МБ.
weights/
runs/*
!runs/hack/
runs/hack/*
!runs/hack/ft_soup_b336_fit/
runs/hack/crops_cache/
# Токены патчей для локального сопоставления: 140 МБ на кеш, а сам подход измерен и
# отвергнут (results/local_verify.json) — держать их в истории незачем.
runs/hack/*/val_*_local*.npz

# --- рабочие каталоги сервиса ---
var/

# --- промежуточные прогоны, не являющиеся сдачей ---
out_*/
submission_*/
release_*/
!release/
example_output/

# --- архивы и бэкапы ---
*.zip
