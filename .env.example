# Скопируй в .env и поправь под свою машину:  cp .env.example .env

# Где лежат данные организаторов (images/, test_query.csv, test_gallery.csv)
# и куда писать три файла сдачи. Используются только профилем predict.
DATA_DIR=./Данные
OUT_DIR=./submission

# Порт, на котором открывается интерфейс прототипа.
WEB_PORT=8080

# cuda или cpu. На стенде жюри (RTX A5000) — cuda.
VREID_DEVICE=cuda

# Пароль СУБД галереи. Меняй, если стек выходит за пределы одной машины.
POSTGRES_PASSWORD=vreid

# Ключ доступа к API. Пустой — без заголовка X-API-Key; наружу публикуется только web.
VREID_API_KEY=

# --- только для сборки на карте sm_120 (RTX 50xx), где CUDA 12.1 не работает ---
# Релизная база собрана под стенд жюри (Ampere, драйвер CUDA 12.2) и на Blackwell не идёт.
# Раскомментируй три строки ниже, чтобы собрать локальный вариант на CUDA 12.8.
# BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
# PIP_FLAGS=--break-system-packages
# REQUIREMENTS=requirements-infer-dev.txt
